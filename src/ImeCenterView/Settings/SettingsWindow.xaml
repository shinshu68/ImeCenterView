<Window x:Class="ImeCenterView.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ImeCenterView の設定"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Loaded="OnLoaded">
    <Window.Resources>
        <Style TargetType="Slider">
            <Setter Property="Width" Value="240" />
            <Setter Property="Margin" Value="12,6" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsSnapToTickEnabled" Value="True" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>
    <!-- スライダーの範囲と値はコードビハインドで AppSettings から設定する -->
    <StackPanel Margin="16">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="70" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="表示時間" />
            <Slider x:Name="HoldSlider" Grid.Row="0" Grid.Column="1" TickFrequency="50" SmallChange="50" LargeChange="500" ValueChanged="OnSliderValueChanged" />
            <TextBlock x:Name="HoldText" Grid.Row="0" Grid.Column="2" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="フェード時間" />
            <Slider x:Name="FadeSlider" Grid.Row="1" Grid.Column="1" TickFrequency="50" SmallChange="50" LargeChange="500" ValueChanged="OnSliderValueChanged" />
            <TextBlock x:Name="FadeText" Grid.Row="1" Grid.Column="2" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="サイズ" />
            <Slider x:Name="SizeSlider" Grid.Row="2" Grid.Column="1" TickFrequency="2" SmallChange="2" LargeChange="20" ValueChanged="OnSliderValueChanged" />
            <TextBlock x:Name="SizeText" Grid.Row="2" Grid.Column="2" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="背景の不透明度" />
            <Slider x:Name="OpacitySlider" Grid.Row="3" Grid.Column="1" TickFrequency="1" SmallChange="1" LargeChange="10" ValueChanged="OnSliderValueChanged" />
            <TextBlock x:Name="OpacityText" Grid.Row="3" Grid.Column="2" />

            <TextBlock Grid.Row="4" Grid.Column="0" Text="ポーリング間隔" />
            <Slider x:Name="PollingSlider" Grid.Row="4" Grid.Column="1" TickFrequency="10" SmallChange="10" LargeChange="100" ValueChanged="OnSliderValueChanged" />
            <TextBlock x:Name="PollingText" Grid.Row="4" Grid.Column="2" />
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="既定値に戻す" Padding="12,4" Click="OnResetClick" />
            <Button Content="閉じる" Padding="12,4" Margin="8,0,0,0" IsCancel="True" IsDefault="True" Click="OnCloseClick" />
        </StackPanel>
    </StackPanel>
</Window>
