<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- タスクトレイの NotifyIcon を使うため -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Per-Monitor V2 の DPI 対応を宣言する -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WFO0003 は WinForms アプリ向けの警告。WPF アプリの DPI 設定はマニフェストで行うのが正しいため抑制する -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <!-- LibraryImport のソース生成に必要 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF と型名が衝突する（Application など）ため、WinForms 系の暗黙の using は外す -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
